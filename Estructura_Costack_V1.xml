  title: 'CoStack — Administrador Invisible de Suscripciones',
  description: 'Gestiona suscripciones compartidas de software para tu equipo freelance. Pagos, acceso ciego y turnos de uso.',
  generator: 'v0.app',
  icons: {
    icon: '/CoStack_Logo.png',
