const tools = ["ChatGPT Plus", "Midjourney", "Canva Pro"]

const statusConfig = {
  paid: {
    label: "Pagado",
    icon: CheckCircle2,
    badge: "bg-emerald-100 text-emerald-700 border-emerald-200",
    dot: "bg-emerald-500",
  },
  pending: {
    label: "Pendiente",
    icon: Clock,
