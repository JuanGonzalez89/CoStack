{
  "name": "provision-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "PLAYWRIGHT_BROWSERS_PATH=0 xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24' tsx src/index.ts",
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium --force",
    "prestart": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium --force 2>/dev/null || true"
  },
  "dependencies": {
    "express": "^4.21.0",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0"
  }
}
