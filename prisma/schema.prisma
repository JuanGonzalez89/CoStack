generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  member
  organizer
}

enum GroupStatus {
  active
  paused
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum SeatStatus {
  free
  assigned
  pending
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole     @default(member)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  posts         CommunityPost[]
  payments      Payment[]
  payoutRequests PayoutRequest[]
}

model Group {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  status      GroupStatus  @default(active)
  automatchEnabled Boolean @default(true)
  cancellationScheduledFor DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Membership[]
  seats       Seat[]
  payments    Payment[]
  posts       CommunityPost[]
  botEvents   BotEvent[]
  toolSubscriptions ToolSubscription[]
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  groupId   String
  role      UserRole   @default(member)
  status    PaymentStatus @default(pending)
  joinedAt  DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Tool {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  provider    String
  monthlyCost Float
  marketPrice Float?
  isBusiness  Boolean  @default(false)
  category    String?
  createdAt   DateTime @default(now())
  seats       Seat[]
  payments    Payment[]
  toolSubscriptions ToolSubscription[]
}

model Seat {
  id             String     @id @default(cuid())
  groupId        String
  toolId         String
  assigneeId     String?
  status         SeatStatus @default(free)
  accessToken    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  expiresAt      DateTime?
  isReported     Boolean    @default(false)
  reportedReason String?
  group          Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tool           Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String       @id @default(cuid())
  userId      String
  groupId     String
  toolId      String
  amount      Float
  status      PaymentStatus @default(pending)
  providerRef String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tool        Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  content   String
  likes     Int      @default(0)
  reposts   Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model BotEvent {
  id        String   @id @default(cuid())
  groupId   String?
  type      String
  message   String
  createdAt DateTime @default(now())
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ToolSubscription {
  id                      String   @id @default(cuid())
  groupId                 String
  toolId                  String
  oauthTokenId            String?
  sharedPasswordEncrypted String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id          String   @id @default(cuid())
  organizerId String
  amount      Float
  provider    String?
  providerRef String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer User @relation(fields: [organizerId], references: [id], onDelete: Cascade)
}
